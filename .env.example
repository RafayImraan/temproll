# Optional UI/API configuration. Leave unset for local-only mode.
API_PORT=8787
PAYROLL_API_URL=http://127.0.0.1:8787
PAYROLL_API_TOKEN=replace-with-a-long-random-local-secret
PAYROLL_API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PAYROLL_DASHBOARD_PROXY_ENABLED=false
SEPOLIA_RPC_URL=https://YOUR_SEPOLIA_RPC_URL
SEPOLIA_DEPLOYER_PRIVATE_KEY=
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://YOUR_PUBLIC_SEPOLIA_RPC_URL
NEXT_PUBLIC_PAYROLL_REGISTRY_ADDRESS=
NEXT_PUBLIC_SEPOLIA_EXPLORER_URL=https://sepolia.etherscan.io
NEXT_PUBLIC_RECURRING_PAYMENTS_ADDRESS=
NEXT_PUBLIC_TEST_PAYROLL_TOKEN_ADDRESS=
NEXT_PUBLIC_GUARDIAN_DEPLOYMENT_BLOCK=
HORIZON_RPC_URL=https://horizen-testnet.rpc.caldera.xyz/http
HORIZON_DEPLOYER_PRIVATE_KEY=
NEXT_PUBLIC_HORIZON_RPC_URL=https://horizen-testnet.rpc.caldera.xyz/http
NEXT_PUBLIC_HORIZON_EXPLORER_URL=https://explorer-testnet.horizen.io
NEXT_PUBLIC_HORIZON_RECURRING_PAYMENTS_ADDRESS=
NEXT_PUBLIC_HORIZON_TEST_PAYROLL_TOKEN_ADDRESS=
NEXT_PUBLIC_HORIZON_GUARDIAN_DEPLOYMENT_BLOCK=
# The NEXT_PUBLIC RPC URL is included in browser code; use a public endpoint without a secret API key.
# Set SEPOLIA_DEPLOYER_PRIVATE_KEY only in a local shell for a deliberate test-wallet deployment; do not store it in this file.
# Never use a valuable wallet for testnet deployment.
